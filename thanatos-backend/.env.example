# Copia este archivo como ".env" y ajusta lo que necesites.
# Todo es opcional: si no existe .env se usan los valores por defecto de app/config.py

WHISPER_MODEL=small
OLLAMA_MODEL=llama3.2:3b
PIPER_VOICE_PATH=voices/es_MX-claude-high.onnx

# Solo si "python -m piper" no funciona en el equipo:
# apunta al ejecutable independiente de Piper.
# PIPER_CMD=C:\piper\piper.exe